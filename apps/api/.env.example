# Copy to apps/api/.env for local development. `pnpm api:dev` and the migration:* scripts load it;
# variables already set in the shell take precedence.
DATABASE_URL=postgres://typing_trainer:typing_trainer@127.0.0.1:5432/typing_trainer
LOG_LEVEL=debug
# The web app's origin; state-changing requests from any other origin are refused (Vite dev server).
APP_ORIGIN=http://localhost:5173
# Development only; production uses its own secret (for example `openssl rand -base64 32`).
PASSWORD_PEPPER=ZGV2ZWxvcG1lbnQtb25seSBwZXBwZXIsIG5vdCBhIHNlY3JldCE=
