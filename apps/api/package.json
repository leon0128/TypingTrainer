{
  "name": "@typing-trainer/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsx scripts/build.ts",
    "start": "node --enable-source-maps dist/main.js",
    "typeorm": "tsx --env-file-if-exists=.env ./node_modules/typeorm/cli.js",
    "migration:generate": "tsx --env-file-if-exists=.env ./node_modules/typeorm/cli.js migration:generate -d src/database/data-source.ts",
    "migration:run": "tsx --env-file-if-exists=.env ./node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
    "migration:revert": "tsx --env-file-if-exists=.env ./node_modules/typeorm/cli.js migration:revert -d src/database/data-source.ts",
    "migration:show": "tsx --env-file-if-exists=.env ./node_modules/typeorm/cli.js migration:show -d src/database/data-source.ts",
    "migration:check": "tsx --env-file-if-exists=.env ./node_modules/typeorm/cli.js migration:generate src/migrations/Unexpected --check -d src/database/data-source.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "@nestjs/typeorm": "12.0.1",
    "@node-rs/argon2": "2.2.1",
    "@typing-trainer/contracts": "workspace:*",
    "@typing-trainer/typing-engine": "workspace:*",
    "fastify": "5.12.1",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.13"
  }
}
