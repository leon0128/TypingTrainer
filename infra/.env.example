# Copy to infra/.env (git-ignored) and fill in. docs/deployment.md explains each value.

# The tag to deploy: the commit hash from infra/docker/version.sh. Also recorded on every run.
APP_VERSION=

# The public host name (Caddy obtains its certificate) and the matching origin.
APP_DOMAIN=typing.example.com
APP_ORIGIN=https://typing.example.com

# Use hex so the value is safe inside a URL: openssl rand -hex 24
POSTGRES_PASSWORD=

# openssl rand -base64 32 -- keep a copy apart from the database and its backups: it is mixed into
# every password hash, so losing it invalidates every password (§7).
PASSWORD_PEPPER=
