# What setup.sh writes to /etc/typing-trainer/env (root-only, mode 600); shown here as the record of
# every value. setup.sh generates the two secrets. systemd reads the file, so no quoting is needed.
APP_ORIGIN=https://typing.example.com
# Caddy runs on the same host and reaches the API over loopback.
TRUST_PROXY=127.0.0.1/32
# Also used by setup.sh to create the database role.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://typing_trainer:<POSTGRES_PASSWORD>@127.0.0.1:5432/typing_trainer
# Keep a copy apart from the server and from the database backups (§7).
PASSWORD_PEPPER=
