{
  "name": "typing-trainer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @typing-trainer/web dev",
    "api:dev": "pnpm --filter @typing-trainer/api dev",
    "db:up": "docker compose -f infra/compose.dev.yaml up -d --wait",
    "db:down": "docker compose -f infra/compose.dev.yaml down",
    "typecheck": "tsc -b",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "content:build": "pnpm --filter @typing-trainer/content-cli run build",
    "content:check": "pnpm --filter @typing-trainer/content-cli run check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.4",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
